; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Product Tycoon"
config/description="Roguelike de gestion produit — le·la CPO hérite d'une équipe et d'un contexte tirés au sort, chaque bonne pratique a un prix caché."
run/main_scene="res://scenes/screens/start_screen.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameData="*res://scripts/autoload/game_data.gd"

[gui]

theme/custom="res://resources/theme/main_theme.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
