; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Product Tycoon"
config/description="Roguelike de gestion produit — le·la CPO hérite d'une équipe et d'un contexte tirés au sort, chaque bonne pratique a un prix caché."
run/main_scene="res://scenes/screens/start_screen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameData="*res://scripts/autoload/game_data.gd"
SprintState="*res://scripts/autoload/sprint_state.gd"

[display]

; La mise en page travaille sur une surface logique 1280x720, puis Godot la
; rend dans une fenêtre 1600x900. Le facteur 1,25 garde les textes 11-16 px
; lisibles sur les écrans Retina sans agrandir chaque composant séparément.
; `canvas_items` préserve aussi cette échelle en plein écran et au
; redimensionnement ; `expand` laisse les grilles responsives utiliser l'espace
; supplémentaire au lieu d'ajouter des bandes noires.
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://resources/theme/main_theme.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
