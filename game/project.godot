; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Product Tycoon"
config/description="Roguelike de gestion produit — le·la CPO hérite d'une équipe et d'un contexte tirés au sort, chaque bonne pratique a un prix caché."
run/main_scene="res://scenes/screens/start_screen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameData="*res://scripts/autoload/game_data.gd"
SprintState="*res://scripts/autoload/sprint_state.gd"

[display]

; 1152x648 était la valeur par défaut de Godot. Depuis que le Panneau de bord
; prend 320 px à droite et que les Investissements empilent deux rayons dans un
; même scroll, il ne restait plus la largeur de deux cartes : la fenêtre part
; désormais assez grande pour un rayon de 4 cartes. Elle reste redimensionnable,
; et le nombre de colonnes des rayons suit la largeur réelle.
window/size/viewport_width=1600
window/size/viewport_height=900

[gui]

theme/custom="res://resources/theme/main_theme.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
