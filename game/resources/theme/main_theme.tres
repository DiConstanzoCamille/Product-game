[gd_resource type="Theme" load_steps=10 format=3]

; Thème clair, direction « Post-it & Feutre » (docs/proposition-ui-interface.md §6,
; piste 1). Le monde de jeu est clair — papier, tableau blanc, fiches cartonnées ;
; seul le panneau de bord (scenes/components/side_panel.tscn) reste sombre, comme
; l'écran TV du standup. Les boutons sont des boutons « papier » : fond blanc,
; filet d'encre épais, l'encre s'inverse à l'appui.

[ext_resource type="FontFile" path="res://assets/fonts/IBMPlexSans-Variable.ttf" id="1_body_font"]
[ext_resource type="FontFile" path="res://assets/fonts/ProductIcons.ttf" id="2_icon_font"]

[sub_resource type="FontVariation" id="FontVariation_body_with_icons"]
base_font = ExtResource("1_body_font")
fallbacks = Array[Font]([ExtResource("2_icon_font")])

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_button_normal"]
bg_color = Color(1, 1, 1, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.164706, 0.184314, 0.219608, 1)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8
content_margin_left = 18.0
content_margin_top = 10.0
content_margin_right = 18.0
content_margin_bottom = 10.0
shadow_color = Color(0.156863, 0.196078, 0.27451, 0.22)
shadow_size = 5
shadow_offset = Vector2(1, 2)

