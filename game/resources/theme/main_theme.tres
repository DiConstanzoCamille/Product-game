[resource]
default_font = SubResource("FontVariation_body_with_icons")
default_font_size = 16
Button/styles/normal = SubResource("StyleBoxFlat_button_normal")
Button/styles/hover = SubResource("StyleBoxFlat_button_hover")
Button/styles/pressed = SubResource("StyleBoxFlat_button_pressed")
Button/styles/focus = SubResource("StyleBoxFlat_button_hover")
Button/styles/disabled = SubResource("StyleBoxFlat_button_disabled")
Button/colors/font_color = Color(0.164706, 0.184314, 0.219608, 1)
Button/colors/font_hover_color = Color(0.164706, 0.184314, 0.219608, 1)
Button/colors/font_pressed_color = Color(1, 1, 1, 1)
Button/colors/font_focus_color = Color(0.164706, 0.184314, 0.219608, 1)
Button/colors/font_disabled_color = Color(0.545098, 0.572549, 0.611765, 1)
Button/font_sizes/font_size = 15
Label/colors/font_color = Color(0.164706, 0.184314, 0.219608, 1)
PanelContainer/styles/panel = SubResource("StyleBoxFlat_panel")
ProgressBar/styles/background = SubResource("StyleBoxFlat_progress_bg")
RichTextLabel/colors/default_color = Color(0.164706, 0.184314, 0.219608, 1)
